# Opcional: para dados em tempo real via Google Sheets API v4
# Obtenha em https://console.cloud.google.com/ (ativar Sheets API e criar API Key)
# GOOGLE_SHEETS_API_KEY=sua_api_key_aqui

# ID da planilha (da URL ao editar: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
# SPREADSHEET_ID=1abc123xyz...

# Faixa de células (opcional, padrão A:Z)
# SHEET_RANGE=A:Z

# Supabase: sync da planilha para o banco (registros_diarios)
# Obtenha em https://supabase.com/dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
