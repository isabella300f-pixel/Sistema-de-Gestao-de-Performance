# --- Planilha (registros diários) - use UMA das opções abaixo ---
# Opção 1: API Google Sheets (recomendado em produção)
# GOOGLE_SHEETS_API_KEY=sua_api_key_aqui
# SPREADSHEET_ID=1abc123xyz...
# SHEET_RANGE=A:Z

# Opção 2: URL publicada da planilha (Formulário > Respostas > Publicar como página)
# Cole a URL do CSV: Arquivo > Compartilhar > Publicar na Web > link que termina em .../pub?output=csv&gid=XXXXX
# PUBLISHED_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv&gid=XXXXX

# Supabase: sync da planilha (registros_diarios) e cache Conta Azul (conta_azul_*)
# Obtenha em https://supabase.com/dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Conta Azul: API financeira + sync para Supabase (veja CONTAAZUL_E_SUPABASE.md)
# CONTA_AZUL_CLIENT_ID=7ckuct0640c8g0uan8ptqdm70
# CONTA_AZUL_CLIENT_SECRET=1h2btu9k06lefqmu8ql47fdskjfqrldup0u2bjep2akrbal4ea5u
# CONTA_AZUL_REFRESH_TOKEN=obtido_pelo_fluxo_oauth (recomendado)
# Alternativa: CONTA_AZUL_USERNAME e CONTA_AZUL_PASSWORD (se permitir password grant)